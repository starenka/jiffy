#!/usr/bin/env bash
# Print the phone's current Wi-Fi IPv4 on whatever network we're on.
# $PHONE_IP wins; otherwise find the "jiffy-<id>" _ssh._tcp mDNS service the app
# advertises while sharing is on (needs avahi-daemon + avahi-browse). <id> is the
# first 6 letters/digits of the host key fingerprint shown in the app.
# With several phones sharing, the one whose id matches a key in ~/.ssh/known_hosts
# (KNOWN_HOSTS to override) is chosen; else set PHONE_ID=<id> (or a prefix) to pick one.
# This only selects; ssh still verifies the host key on connect.
set -u

if [ -n "${PHONE_IP:-}" ]; then
    echo "$PHONE_IP"
    exit 0
fi

if ! command -v avahi-browse >/dev/null; then
    echo "phone-ip: avahi-browse not installed; set PHONE_IP=<ip>" >&2
    exit 1
fi

# Resolved records: =;iface;proto;name;type;domain;host;address;port;txt
# (proto is the query protocol, so an IPv4 address can show up on an IPv6 line)
# The phone sometimes misses the first multicast query while its Wi-Fi is idle, so retry.
found=
for _ in 1 2 3; do
    found=$(avahi-browse -rtp _ssh._tcp 2>/dev/null |
        awk -F';' -v id="${PHONE_ID:-}" '
            $1 == "=" && $4 ~ /^jiffy-/ && $8 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ &&
            index(tolower($4), tolower("jiffy-" id)) == 1 { print $4, $8 }' | sort -u)
    [ -n "$found" ] && break
done

count=$(printf '%s' "$found" | grep -c .)
if [ "$count" -eq 0 ]; then
    echo "phone-ip: no jiffy service found on this network. Is sharing started and the phone on the same Wi-Fi? Or set PHONE_IP=<ip>." >&2
    exit 1
elif [ "$count" -gt 1 ] && [ -z "${PHONE_ID:-}" ]; then
    # Prefer phones whose host key we already know. Fingerprints look like SHA256:<base64>.
    known=$(ssh-keygen -lf "${KNOWN_HOSTS:-$HOME/.ssh/known_hosts}" 2>/dev/null |
        awk '{ sub(/^SHA256:/, "", $2); gsub(/[^A-Za-z0-9]/, "", $2); print "jiffy-" substr($2, 1, 6) }' | sort -u)
    trusted=$(printf '%s\n' "$found" | awk 'NR == FNR { k[$0]; next } ($1 in k)' <(printf '%s\n' "$known") -)
    if [ "$(printf '%s' "$trusted" | grep -c .)" -eq 1 ]; then
        echo "${trusted#* }"
        exit 0
    fi
fi
if [ "$count" -gt 1 ]; then
    echo "phone-ip: several phones found, set PHONE_ID=<id> or PHONE_IP=<ip>:" >&2
    printf '%s\n' "$found" | sed 's/^jiffy-/  /' >&2
    exit 1
fi
echo "${found#* }"
